  "Read_Me": [
    [
      "Stage 1 Scoring Matrix and Implementation Guide",
      null
    ],
    [
      "Purpose",
      "Defines how student dimension scores are converted into course-family suitability scores for the Stage 1 adaptive assessment."
    ],
    [
      "Important",
      "The matrix is a starting heuristic, not a scientifically validated prediction model. Validate with faculty/career experts and pilot data before production decisions."
    ],
    [
      "Core flow",
      "Question → selected option → dimension evidence → normalized dimension scores → course-family suitability → eligibility filter → confidence → Stage 1 result."
    ],
    [
      "Dimensions",
      "12 dimensions: AR, LR, QR, PS, SC, RE, TC, CR, CO, SO, LE, BU."
    ],
    [
      "Course families",
      "15 broad families are scored. Stage 2 should then specialize within the strongest eligible families."
    ],
    [
      "Weight scale",
      "0–5. 5 = very strong relevance, 4 = strong, 3 = moderate, 2 = supporting, 1 = minor, 0 = not used."
    ],
    [
      "Important scoring rule",
      "Do not treat the final suitability score as probability of success. It is a fit/suitability index on a 0–100 scale."
    ]
  ],
